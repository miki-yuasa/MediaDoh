{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-storage",
  "description": "Windows-specific capability for accessing external drives",
  "platforms": ["windows"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "C:/**" },
        { "path": "D:/**" },
        { "path": "E:/**" },
        { "path": "F:/**" },
        { "path": "G:/**" },
        { "path": "H:/**" },
        { "path": "I:/**" },
        { "path": "J:/**" },
        { "path": "K:/**" },
        { "path": "L:/**" },
        { "path": "M:/**" },
        { "path": "N:/**" },
        { "path": "O:/**" },
        { "path": "P:/**" },
        { "path": "Q:/**" },
        { "path": "R:/**" },
        { "path": "S:/**" },
        { "path": "T:/**" },
        { "path": "U:/**" },
        { "path": "V:/**" },
        { "path": "W:/**" },
        { "path": "X:/**" },
        { "path": "Y:/**" },
        { "path": "Z:/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "D:/**" },
        { "path": "E:/**" },
        { "path": "F:/**" },
        { "path": "G:/**" },
        { "path": "H:/**" },
        { "path": "I:/**" },
        { "path": "J:/**" },
        { "path": "K:/**" },
        { "path": "L:/**" },
        { "path": "M:/**" },
        { "path": "N:/**" },
        { "path": "O:/**" },
        { "path": "P:/**" },
        { "path": "Q:/**" },
        { "path": "R:/**" },
        { "path": "S:/**" },
        { "path": "T:/**" },
        { "path": "U:/**" },
        { "path": "V:/**" },
        { "path": "W:/**" },
        { "path": "X:/**" },
        { "path": "Y:/**" },
        { "path": "Z:/**" }
      ]
    }
  ]
}
